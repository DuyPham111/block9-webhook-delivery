# Mẫu cấu hình. KHÔNG chứa secret thật.
# docker compose đã đặt sẵn các biến này; file này để chạy process ngoài container.

DATABASE_URL_SENDER=postgres://app:app@127.0.0.1:15432/sender
DATABASE_URL_RECEIVER=postgres://app:app@127.0.0.1:15432/receiver

WEBHOOK_URL=http://127.0.0.1:3001/webhooks/summaries
WEBHOOK_SECRET=thay-bang-secret-rieng
WEBHOOK_SOURCE=summary-service

HTTP_TIMEOUT_MS=2000
MAX_ATTEMPTS_PER_ROUND=4
RETRY_DELAYS_MS=1000,3000,9000
RETRY_AFTER_MAX_S=300
MAX_REPLAYS=4
TIMESTAMP_WINDOW_S=300

# Điểm dừng để harness kill process. Rỗng = không bật marker nào.
#   sender: after_job_update_before_outbox | after_sender_commit_before_response
#   relay:  after_http_2xx_before_delivery_commit
MARKER=
MARKER_RELEASE_FILE=
